# Secrets shared across all environments — goes in .env (gitignored, never commit).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Non-secret, per-environment config — goes in .env.development / .env.production
# (committed). Must exactly match a Redirect URI registered on the Spotify app
# dashboard for that environment.
SPOTIFY_REDIRECT_URI=

# Secret, per-environment — goes in .env.development.local for local dev
# (gitignored, never commit). For production, set this in the Vercel project's
# Environment Variables dashboard instead — Vercel does not read a committed
# .env.production.local file.
#
# Obtained once per environment: visit /api/spotify/login on that environment,
# approve access, then copy the refresh_token from the /api/spotify/callback
# response.
SPOTIFY_REFRESH_TOKEN=
